    "# Evaluate ALL models on test (both gold-only and expanded)\n",
    "test_results = []\n",
    "\n",
    "for name in models_gold:\n",
    "    print(f\"Evaluating {name} (gold-only)...\")\n",
    "    pred_gold = models_gold[name].transform(test)\n",
    "    m_gold = evaluate_model_full(pred_gold, f\"{name}_Gold\")\n",
    "    test_results.append(m_gold)\n",
    "    \n",
    "    pred_exp = models_expanded[name].transform(test)\n",
    "    m_exp = evaluate_model_full(pred_exp, f\"{name}_Expanded\")\n",
    "    test_results.append(m_exp)\n",
    "    \n",
    "    print(f\"  Gold: Macro-F1={m_gold['macro_f1']:.4f}, PR-AUC={m_gold['pr_auc']:.4f}\")\n",
    "    print(f\"  Exp:  Macro-F1={m_exp['macro_f1']:.4f}, PR-AUC={m_exp['pr_auc']:.4f}\")"
   ]

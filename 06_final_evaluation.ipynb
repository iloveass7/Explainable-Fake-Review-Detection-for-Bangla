    "# ============================================================\n",
    "# 4. ERROR ANALYSIS\n",
    "# ============================================================\n",
    "# Use best expanded model predictions\n",
    "best_model_name = \"LR\"  # from Week 5\n",
    "best_pred = models_expanded[best_model_name].transform(test)\n",
    "\n",
    "# Convert to pandas for analysis\n",
    "test_pd = best_pred.select(\n",
    "    \"review_id\", \"review\", \"clean_review\", \"label\", \"prediction\",\n",
    "    \"probability\", \"char_length\", \"token_count\", \"codemix_ratio\",\n",
    "    \"promo_keyword_hits\", \"exact_dup_cluster_size\", \"dup_cluster_size\",\n",
    "    \"has_promo\", \"has_emoji\", \"has_url\", \"has_price\"\n",
    ").toPandas()\n",
    "\n",
    "test_pd[\"correct\"] = (test_pd[\"label\"] == test_pd[\"prediction\"]).astype(int)\n",
    "test_pd[\"error_type\"] = \"correct\"\n",
    "test_pd.loc[(test_pd[\"label\"]==0) & (test_pd[\"prediction\"]==1), \"error_type\"] = \"false_negative\"\n",
    "test_pd.loc[(test_pd[\"label\"]==1) & (test_pd[\"prediction\"]==0), \"error_type\"] = \"false_positive\"\n",
    "\n",
    "print(\"Error distribution:\")\n",
    "print(test_pd[\"error_type\"].value_counts())\n",
    "\n",
    "# False negatives (fake predicted as genuine)\n",
    "fn = test_pd[test_pd[\"error_type\"] == \"false_negative\"]\n",
    "fp = test_pd[test_pd[\"error_type\"] == \"false_positive\"]\n",
    "correct = test_pd[test_pd[\"error_type\"] == \"correct\"]\n",
    "\n",
    "print(f\"\\nFalse Negatives (fake->genuine): {len(fn)}\")\n",
    "print(f\"  Avg length: {fn['char_length'].mean():.1f}\")\n",
    "print(f\"  Avg codemix: {fn['codemix_ratio'].mean():.3f}\")\n",
    "print(f\"  Promo rate: {fn['has_promo'].mean():.3f}\")\n",
    "print(f\"  Dup cluster: {fn['dup_cluster_size'].mean():.1f}\")\n",
    "\n",
    "print(f\"\\nFalse Positives (genuine->fake): {len(fp)}\")\n",
    "print(f\"  Avg length: {fp['char_length'].mean():.1f}\")\n",
    "print(f\"  Avg codemix: {fp['codemix_ratio'].mean():.3f}\")\n",
    "print(f\"  Promo rate: {fp['has_promo'].mean():.3f}\")\n",
    "print(f\"  Dup cluster: {fp['dup_cluster_size'].mean():.1f}\")"
   ]

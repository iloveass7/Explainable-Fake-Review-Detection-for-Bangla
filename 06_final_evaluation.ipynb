    "# ============================================================\n",
    "# 1. FINAL TEST EVALUATION (ONCE!)\n",
    "# ============================================================\n",
    "\n",
    "def evaluate_model_full(predictions, name):\n",
    "    \"\"\"Comprehensive evaluation metrics.\"\"\"\n",
    "    metrics = {\"model\": name}\n",
    "    \n",
    "    # Primary\n",
    "    metrics[\"macro_f1\"] = MulticlassClassificationEvaluator(\n",
    "        labelCol=\"label\", predictionCol=\"prediction\", metricName=\"f1\"\n",
    "    ).evaluate(predictions)\n",
    "    \n",
    "    metrics[\"pr_auc\"] = BinaryClassificationEvaluator(\n",
    "        labelCol=\"label\", rawPredictionCol=\"rawPrediction\", metricName=\"areaUnderPR\"\n",
    "    ).evaluate(predictions)\n",
    "    \n",
    "    # Supporting\n",
    "    metrics[\"accuracy\"] = MulticlassClassificationEvaluator(\n",
    "        labelCol=\"label\", predictionCol=\"prediction\", metricName=\"accuracy\"\n",
    "    ).evaluate(predictions)\n",
    "    \n",
    "    metrics[\"roc_auc\"] = BinaryClassificationEvaluator(\n",
    "        labelCol=\"label\", rawPredictionCol=\"rawPrediction\", metricName=\"areaUnderROC\"\n",
    "    ).evaluate(predictions)\n",
    "    \n",
    "    # Per-class\n",
    "    for cls in [0, 1]:\n",
    "        cls_name = \"fake\" if cls == 0 else \"genuine\"\n",
    "        metrics[f\"{cls_name}_precision\"] = MulticlassClassificationEvaluator(\n",
    "            labelCol=\"label\", predictionCol=\"prediction\",\n",
    "            metricName=\"precisionByLabel\", metricLabel=cls\n",
    "        ).evaluate(predictions)\n",
    "        metrics[f\"{cls_name}_recall\"] = MulticlassClassificationEvaluator(\n",
    "            labelCol=\"label\", predictionCol=\"prediction\",\n",
    "            metricName=\"recallByLabel\", metricLabel=cls\n",
    "        ).evaluate(predictions)\n",
    "        metrics[f\"{cls_name}_f1\"] = MulticlassClassificationEvaluator(\n",
    "            labelCol=\"label\", predictionCol=\"prediction\",\n",
    "            metricName=\"f1ByLabel\", metricLabel=cls\n",
    "        ).evaluate(predictions)\n",
    "    \n",
    "    # Confusion matrix\n",
    "    cm = predictions.groupBy(\"label\", \"prediction\").count().collect()\n",
    "    cm_matrix = np.zeros((2, 2), dtype=int)\n",
    "    for row in cm:\n",
    "        cm_matrix[int(row[\"label\"]), int(row[\"prediction\"])] = row[\"count\"]\n",
    "    metrics[\"confusion_matrix\"] = cm_matrix.tolist()\n",
    "    \n",
    "    # Prediction distribution\n",
    "    pred_dist = predictions.groupBy(\"prediction\").count().collect()\n",
    "    metrics[\"pred_distribution\"] = {str(r[\"prediction\"]): r[\"count\"] for r in pred_dist}\n",
    "    \n",
    "    return metrics"
   ]
  },

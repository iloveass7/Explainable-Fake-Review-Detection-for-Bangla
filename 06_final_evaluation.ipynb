    "# ============================================================\n",
    "# 5. GLOBAL EXPLAINABILITY: LR COEFFICIENTS\n",
    "# ============================================================\n",
    "print(\"=== GLOBAL EXPLANATIONS ===\")\n",
    "\n",
    "# Load TF-IDF vocabulary\n",
    "cv_model = CountVectorizerModel.load(str(MODELS_DIR / \"countvectorizer\"))\n",
    "tfidf_vocab = cv_model.vocabulary\n",
    \n",
    "hc_feature_names = [\n",
    "    \"char_length\", \"token_count\", \"codemix_ratio\", \"repeated_char_ratio\",\n",
    "    \"url_count\", \"phone_count\", \"price_count\", \"hashtag_count\",\n",
    "    \"exclamation_count\", \"emoji_count\", \"promo_keyword_hits\",\n",
    "    \"bengali_chars\", \"latin_chars\", \"digit_chars\", \"other_chars\",\n",
    "    \"exact_dup_cluster_size\", \"dup_degree\", \"dup_cluster_size\",\n",
    "    \"has_url\", \"has_phone\", \"has_price\", \"has_promo\", \"has_emoji\", \"is_exact_duplicate\"\n",
    "]\n",
    "\n",
    "all_features = tfidf_vocab + hc_feature_names\n",
    "\n",
    "# Gold-only LR\n",
    "lr_gold_coeffs = final_gold.coefficients.toArray()\n",
    "lr_gold_intercept = final_gold.intercept\n",
    "\n",
    "# Expanded LR\n",
    "lr_exp_coeffs = final_expanded.coefficients.toArray()\n",
    "lr_exp_intercept = final_expanded.intercept\n",
    "\n",
    "coeff_df = pd.DataFrame({\n",
    "    \"feature\": all_features,\n",
    "    \"gold_coeff\": lr_gold_coeffs,\n",
    "    \"expanded_coeff\": lr_exp_coeffs\n",
    "})\n",
    "coeff_df[\"coeff_diff\"] = coeff_df[\"expanded_coeff\"] - coeff_df[\"gold_coeff\"]\n",
    "\n",
    "print(\"Top 20 features pushing toward GENUINE (positive coeff):\")\n",
    "top_pos = coeff_df.nlargest(20, \"expanded_coeff\")\n",
    "print(top_pos[\"feature\", \"gold_coeff\", \"expanded_coeff\", \"coeff_diff\"].to_string())\n",
    "\n",
    "print(\"\\nTop 20 features pushing toward FAKE (negative coeff):\")\n",
    "top_neg = coeff_df.nsmallest(20, \"expanded_coeff\")\n",
    "print(top_neg[\"feature\", \"gold_coeff\", \"expanded_coeff\", \"coeff_diff\"].to_string())\n",
    "\n",
    "coeff_df.to_csv(REPORT_DIR / \"lr_coefficients_comparison.csv\", index=False)"
   ]
  },

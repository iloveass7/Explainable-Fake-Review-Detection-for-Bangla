   "source": [
    "# ============================================================\n",
    "# 7. LOCAL EXPLANATIONS WITH LIME\n",
    "# ============================================================\n",
    "print(\"=== LIME LOCAL EXPLANATIONS ===\")\n",
    "\n",
    "# Prepare a wrapper for the LR model\n",
    "from pyspark.ml.linalg import DenseVector\n",
    "\n",
    "# Get the CV and IDF models\n",
    "cv_model = CountVectorizerModel.load(str(MODELS_DIR / \"countvectorizer\"))\n",
    "from pyspark.ml.feature import IDFModel\n",
    "idf_model = IDFModel.load(str(MODELS_DIR / \"idf\"))\n",
    "w2v_model = Word2VecModel.load(str(MODELS_DIR / \"word2vec\"))\n",
    "\n",
    "# LIME needs a predict_proba function\n",
    "def predict_proba_lr(texts):\n",
    "    \"\"\"Wrapper for LIME: texts -> probabilities for LR.\"\"\"\n",
    "    pdf = pd.DataFrame({\"review\": texts})\n",
    "    sdf = spark.createDataFrame(pdf)\n",
    "    \n",
    "    # Apply same preprocessing pipeline\n",
    "    # This is simplified - in practice, reuse the full pipeline\n",
    "    sdf = sdf.withColumn(\"clean_review\", clean_text_udf(F.col(\"review\")))\n",
    "    sdf = sdf.withColumn(\"tokens\", tokenize_bangla_udf(F.col(\"clean_review\")))\n",
    "    sdf = cv_model.transform(sdf)\n",
    "    sdf = idf_model.transform(sdf)\n",
    "    \n",
    "    # Add dummy handcrafted features\n",
    "    for f in hc_feature_names:\n",
    "        sdf = sdf.withColumn(f, F.lit(0.0))\n",
    "    \n",
    "    assembler = VectorAssembler(inputCols=[\"tfidf\"] + hc_feature_names, outputCol=\"features\")\n",
    "    sdf = assembler.transform(sdf)\n",
    "    \n",
    "    preds = final_expanded.transform(sdf)\n",
    "    probs = preds.select(\"probability\").collect()\n",
    "    \n",
    "    return np.array([[float(p[\"probability\"][0]), float(p[\"probability\"][1])] for p in probs])\n",
    "\n",
    "# Sample test cases for LIME\n",
    "test_sample = test_pd.sample(n=min(15, len(test_pd)), random_state=42)\n",
    "\n",
    "explainer = LimeTextExplainer(class_names=[\"Fake\", \"Genuine\"])\n",
    "\n",
    "lime_explanations = []\n",
    "for idx, row in test_sample.iterrows():\n",
    "    try:\n",
    "        exp = explainer.explain_instance(\n",
    "            row[\"clean_review\"],\n",
    "            predict_proba_lr,\n",
    "            num_features=10,\n",
    "            num_samples=500\n",
    "        )\n",
    "        lime_explanations.append({\n",
    "            \"review_id\": row[\"review_id\"],\n",
    "            \"true_label\": int(row[\"label\"]),\n",
    "            \"pred_label\": int(row[\"prediction\"]),\n",
    "            \"explanation\": exp.as_list()\n",
    "        })\n",
    "        print(f\"Explained review {row['review_id']}: {exp.as_list()[:5]}\")\n",
    "    except Exception as e:\n",
    "        print(f\"LIME failed for {row['review_id']}: {e}\")\n",
    "\n",
    "# Save LIME results\n",
    "with open(REPORT_DIR / \"lime_explanations.json\", 'w') as f:\n",
    "    json.dump(lime_explanations, f, indent=2, default=str)"
   ]

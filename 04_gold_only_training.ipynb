   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# SPARK SESSION\n",
    "# ============================================================\n",
    "spark = (SparkSession.builder\n",
    "    .appName(\"BanglaFakeReview_W4\")\n",
    "    .config(\"spark.sql.adaptive.enabled\", \"true\")\n",
    "    .config(\"spark.driver.memory\", \"8g\")\n",
    "    .config(\"spark.executor.memory\", \"8g\")\n",
    "    .config(\"spark.sql.shuffle.partitions\", \"8\")\n",
    "    .getOrCreate())\n",
    "\n",
    "spark.sparkContext.setLogLevel(\"WARN\")\n",
    "print(f\"Spark {spark.version}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# PATHS & LOAD DATA\n",
    "# ============================================================\n",
    "BASE_DIR = Path(\"/kaggle/working/bangla_fake_review\")\n",
    "PROCESSED_DIR = BASE_DIR / \"processed\"\n",
    "MODELS_DIR = BASE_DIR / \"models\"\n",
    "RESULTS_DIR = BASE_DIR / \"results\"\n",
    "RESULTS_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "train = spark.read.parquet(str(PROCESSED_DIR / \"train_model_ready.parquet\"))\n",
    "val = spark.read.parquet(str(PROCESSED_DIR / \"val_model_ready.parquet\"))\n",
    "test = spark.read.parquet(str(PROCESSED_DIR / \"test_model_ready.parquet\"))\n",
    "\n",
    "print(f\"Train: {train.count()}\")\n",
    "print(f\"Val: {val.count()}\")\n",
    "print(f\"Test: {test.count()}\")\n",
    "\n",
    "# Class weights for imbalance (fake=0 is minority)\n",
    "train_counts = train.groupBy(\"label\").count().collect()\n",
    "total = sum(r[\"count\"] for r in train_counts)\n",
    "class_weights = {}\n",
    "for r in train_counts:\n",
    "    class_weights[r[\"label\"]] = total / (2 * r[\"count\"])\n",
    "print(f\"Class weights: {class_weights}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 1. DEFINE EVALUATION METRICS\n",
    "# ============================================================\n",
    "# Primary: Macro-F1, PR-AUC\n",
    "macro_f1_evaluator = MulticlassClassificationEvaluator(\n",
    "    labelCol=\"label\",\n",
    "    predictionCol=\"prediction\",\n",
    "    metricName=\"f1\"  # This is macro-F1 in Spark\n",
    ")\n",
    "\n",
    "pr_auc_evaluator = BinaryClassificationEvaluator(\n",
    "    labelCol=\"label\",\n",
    "    rawPredictionCol=\"rawPrediction\",  # or probabilityCol\n",
    "    metricName=\"areaUnderPR\"\n",
    ")\n",
    "\n",
    "# Supporting\n",
    "accuracy_evaluator = MulticlassClassificationEvaluator(\n",
    "    labelCol=\"label\", predictionCol=\"prediction\", metricName=\"accuracy\"\n",
    ")\n",
    "roc_auc_evaluator = BinaryClassificationEvaluator(\n",
    "    labelCol=\"label\", rawPredictionCol=\"rawPrediction\", metricName=\"areaUnderROC\"\n",
    ")\n",
    "precision_evaluator = MulticlassClassificationEvaluator(\n",
    "    labelCol=\"label\", predictionCol=\"prediction\", metricName=\"weightedPrecision\"\n",
    ")\n",
    "recall_evaluator = MulticlassClassificationEvaluator(\n",
    "    labelCol=\"label\", predictionCol=\"prediction\", metricName=\"weightedRecall\"\n",
    ")\n",
    "\n",
    "def evaluate_model(predictions, name):\n",
    "    \"\"\"Compute all metrics.\"\"\"\n",
    "    metrics = {}\n",
    "    metrics[\"model\"] = name\n",
    "    metrics[\"macro_f1\"] = macro_f1_evaluator.evaluate(predictions)\n",
    "    metrics[\"pr_auc\"] = pr_auc_evaluator.evaluate(predictions)\n",
    "    metrics[\"accuracy\"] = accuracy_evaluator.evaluate(predictions)\n",
    "    metrics[\"roc_auc\"] = roc_auc_evaluator.evaluate(predictions)\n",
    "    metrics[\"weighted_precision\"] = precision_evaluator.evaluate(predictions)\n",
    "    metrics[\"weighted_recall\"] = recall_evaluator.evaluate(predictions)\n",
    "    \n",
    "    # Per-class metrics\n",
    "    for cls in [0, 1]:\n",
    "        cls_prec = MulticlassClassificationEvaluator(\n",
    "            labelCol=\"label\", predictionCol=\"prediction\",\n",
    "            metricName=\"precisionByLabel\", metricLabel=cls\n",
    "        ).evaluate(predictions)\n",
    "        cls_rec = MulticlassClassificationEvaluator(\n",
    "            labelCol=\"label\", predictionCol=\"prediction\",\n",
    "            metricName=\"recallByLabel\", metricLabel=cls\n",
    "        ).evaluate(predictions)\n",
    "        cls_f1 = MulticlassClassificationEvaluator(\n",
    "            labelCol=\"label\", predictionCol=\"prediction\",\n",
    "            metricName=\"f1ByLabel\", metricLabel=cls\n",
    "        ).evaluate(predictions)\n",
    "        metrics[f\"class_{cls}_precision\"] = cls_prec\n",
    "        metrics[f\"class_{cls}_recall\"] = cls_rec\n",
    "        metrics[f\"class_{cls}_f1\"] = cls_f1\n",
    "    \n",
    "    # Confusion matrix\n",
    "    cm = predictions.groupBy(\"label\", \"prediction\").count().collect()\n",
    "    cm_dict = {}\n",
    "    for row in cm:\n",
    "        cm_dict[f\"true_{int(row['label'])}_pred_{int(row['prediction'])}\"] = row[\"count\"]\n",
    "    metrics[\"confusion_matrix\"] = cm_dict\n",
    "    \n",
    "    return metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 2. LOGISTIC REGRESSION (with CV)\n",
    "# ============================================================\n",
    "print(\"=== Logistic Regression ===\")\n",
    "\n",
    "lr = LogisticRegression(\n",
    "    featuresCol=\"features_linear\",\n",
    "    labelCol=\"label\",\n",
    "    weightCol=None,  # We'll use instance weights via sample weights\n",
    "    maxIter=100,\n",
    "    regParam=0.1,\n",
    "    elasticNetParam=0.0,  # L2\n",
    "    family=\"binomial\",\n",
    "    probabilityCol=\"probability\",\n",
    "    rawPredictionCol=\"rawPrediction\",\n",
    "    predictionCol=\"prediction\",\n",
    "    standardization=True,\n",
    "    threshold=0.5\n",
    ")\n",
    "\n",
    "# Param grid for CV\n",
    "lr_grid = ParamGridBuilder() \\\n",
    "    .addGrid(lr.regParam, [0.01, 0.1, 1.0]) \\\n",
    "    .addGrid(lr.elasticNetParam, [0.0, 0.5, 1.0]) \\\n",
    "    .build()\n",
    "\n",
    "lr_cv = CrossValidator(\n",
    "    estimator=lr,\n",
    "    estimatorParamMaps=lr_grid,\n",
    "    evaluator=macro_f1_evaluator,\n",
    "    numFolds=3,\n",
    "    seed=42,\n",
    "    parallelism=4\n",
    ")\n",
    "\n",
    "print(\"Fitting LR with CV...\")\n",
    "lr_cv_model = lr_cv.fit(train)\n",
    "lr_best = lr_cv_model.bestModel\n",
    "\n",
    "print(f\"Best regParam: {lr_best.getRegParam()}\")\n",
    "print(f\"Best elasticNetParam: {lr_best.getElasticNetParam()}\")\n",
    "\n",
    "# Evaluate on validation\n",
    "val_pred_lr = lr_best.transform(val)\n",
    "lr_metrics = evaluate_model(val_pred_lr, \"LogisticRegression\")\n",
    "print(f\"Val Macro-F1: {lr_metrics['macro_f1']:.4f}\")\n",
    "print(f\"Val PR-AUC: {lr_metrics['pr_auc']:.4f}\")\n",
    "\n",
    "# Save\n",
    "lr_best.write().overwrite().save(str(MODELS_DIR / \"lr_best\"))\n",
    "val_pred_lr.select(\"review_id\", \"label\", \"prediction\", \"probability\", \"rawPrediction\") \\\n",
    "    .write.mode(\"overwrite\").parquet(str(RESULTS_DIR / \"val_pred_lr.parquet\"))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",

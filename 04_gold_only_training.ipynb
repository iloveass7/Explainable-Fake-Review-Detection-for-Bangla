    "# ============================================================\n",
    "# 11. CALIBRATION CHECK (for pseudo-labeling threshold)\n",
    "# ============================================================\n",
    "print(\"=== Probability Calibration Check (LR on Val) ===\")\n",
    "\n",
    "val_pred_lr_pd = val_pred_lr.select(\"label\", \"probability\").toPandas()\n",
    "\n",
    "# Extract probability of class 1 (genuine)\n",
    "val_pred_lr_pd[\"prob_genuine\"] = val_pred_lr_pd[\"probability\"].apply(lambda x: float(x[1]))\n",
    "val_pred_lr_pd[\"prob_fake\"] = val_pred_lr_pd[\"probability\"].apply(lambda x: float(x[0]))\n",
    "val_pred_lr_pd[\"max_prob\"] = val_pred_lr_pd[[\"prob_fake\", \"prob_genuine\"]].max(axis=1)\n",
    "val_pred_lr_pd[\"pred_class\"] = (val_pred_lr_pd[\"prob_genuine\"] > 0.5).astype(int)\n",
    "val_pred_lr_pd[\"correct\"] = (val_pred_lr_pd[\"label\"] == val_pred_lr_pd[\"pred_class\"]).astype(int)\n",
    "\n",
    "# Binned calibration\n",
    "bins = np.linspace(0, 1, 11)\n",
    "val_pred_lr_pd[\"bin\"] = pd.cut(val_pred_lr_pd[\"max_prob\"], bins=bins, include_lowest=True)\n",
    "\n",
    "calib = val_pred_lr_pd.groupby(\"bin\", observed=False).agg(\n",
    "    count=(\"label\", \"count\"),\n",
    "    accuracy=(\"correct\", \"mean\"),\n",
    "    avg_confidence=(\"max_prob\", \"mean\")\n",
    ").reset_index()\n",
    "\n",
    "print(calib.to_string())\n",
    "\n",
    "# Pseudo-label acceptance at different thresholds\n",
    "for thresh in [0.90, 0.95, 0.99]:\n",
    "    accepted = val_pred_lr_pd[val_pred_lr_pd[\"max_prob\"] > thresh]\n",
    "    if len(accepted) > 0:\n",
    "        acc = accepted[\"correct\"].mean()\n",
    "        print(f\"Threshold {thresh}: {len(accepted)} accepted, accuracy={acc:.4f}\")\n",
    "        print(f\"  Class dist: {accepted['pred_class'].value_counts().to_dict()}\")\n",
    "    else:\n",
    "        print(f\"Threshold {thresh}: 0 accepted\")"
   ]
  },

    "# ============================================================\n",
    "# 8. SELECT BEST MODEL FOR PSEUDO-LABELING\n",
    "# ============================================================\n",
    "# Primary criterion: Macro-F1, tie-break: PR-AUC\n",
    "best_idx = metrics_df[\"macro_f1\"].idxmax()\n",
    "best_model_name = metrics_df.loc[best_idx, \"model\"]\n",
    "best_macro_f1 = metrics_df.loc[best_idx, \"macro_f1\"]\n",
    "best_pr_auc = metrics_df.loc[best_idx, \"pr_auc\"]\n",
    "\n",
    "print(f\"\\nBest model: {best_model_name}\")\n",
    "print(f\"  Macro-F1: {best_macro_f1:.4f}\")\n",
    "print(f\"  PR-AUC: {best_pr_auc:.4f}\")\n",
    "\n",
    "# Map to model object\n",

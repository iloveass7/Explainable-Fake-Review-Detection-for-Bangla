    "print(f\"Val PR-AUC: {nb_metrics['pr_auc']:.4f}\")\n",
    "\n",
    "nb_best.write().overwrite().save(str(MODELS_DIR / \"nb_best\"))\n",
    "val_pred_nb.select(\"review_id\", \"label\", \"prediction\", \"probability\", \"rawPrediction\") \\\n",
    "    .write.mode(\"overwrite\").parquet(str(RESULTS_DIR / \"val_pred_nb.parquet\"))"
   ]
  },
  {

   "source": [
    "# ---- Handcrafted signal distributions ----\n",
    "signal_cols = ['url_count', 'phone_count', 'price_count', 'hashtag_count',\n",
    "               'exclamation_count', 'emoji_count', 'promo_keyword_hits',\n",
    "               'has_url', 'has_phone', 'has_price', 'has_promo', 'has_emoji']\n",
    "\n",
    "signal_stats = spark.sql(f\"\"\"\n",
    "SELECT label,\n",
    "       {},\n",
    "       AVG(codemix_ratio) as avg_codemix,\n",
    "       AVG(repeated_char_ratio) as avg_repeated_ratio\n",
    "FROM gold\n",
    "GROUP BY label\n",
    "\"\"\".format(',\n       '.join([f'AVG({c}) as avg_{c}' for c in signal_cols]))).toPandas()\n",
    "\n",
    "print(signal_stats.to_string())\n",
    "\n",
    "# Bar charts for binary signals\n",
    "binary_sigs = ['has_url', 'has_phone', 'has_price', 'has_promo', 'has_emoji']\n",
    "fig, axes = plt.subplots(2, 3, figsize=(15, 8))\n",

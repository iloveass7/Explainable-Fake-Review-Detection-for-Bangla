    "    axes[1, i].set_title(f'Token Count - Label {label}')\n",
    "    axes[1, i].set_xlabel('Tokens')\n",
    "plt.tight_layout()\n",
    "plt.savefig(EDA_DIR / 'length_distributions.png', dpi=150)\n",
    "plt.close()"
   ]

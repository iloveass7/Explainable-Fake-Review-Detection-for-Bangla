    "# ---- Text length & token count by class ----\n",
    "length_stats = spark.sql(\"\"\"\n",
    "SELECT label,\n",
    "       AVG(char_length) as avg_len,\n",
    "       PERCENTILE_APPROX(char_length, 0.5) as median_len,\n",
    "       AVG(token_count) as avg_tokens,\n",
    "       PERCENTILE_APPROX(token_count, 0.5) as median_tokens\n",
    "FROM gold\n",
    "GROUP BY label\n",
    "\"\"\").toPandas()\n",
    "print(length_stats.to_string())\n",
    "\n",
    "# Histograms\n",
    "gold_pdf = gold_feat.select(\"label\", \"char_length\", \"token_count\").toPandas()\n",
    "\n",

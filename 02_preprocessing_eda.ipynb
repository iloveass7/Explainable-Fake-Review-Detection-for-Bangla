    "# ============================================================\n",
    "# 7. SAVE FEATURE-ENRICHED DATA\n",
    "# ============================================================\n",
    "gold_feat.write.mode(\"overwrite\").parquet(str(PROCESSED_DIR / \"bfrd_gold_features.parquet\"))\n",
    "bangrev_feat.write.mode(\"overwrite\").parquet(str(PROCESSED_DIR / \"bangrev_features.parquet\"))\n",
    "\n",
    "# Also save test set with features (but don't use for training!)\n",
    "test_feat = (test_locked\n",
    "    .withColumn(\"clean_review\", clean_text_udf(F.col(\"review\")))\n",
    "    .withColumn(\"tokens\", tokenize_bangla_udf(F.col(\"clean_review\")))\n",
    "    .withColumn(\"token_count\", F.size(F.col(\"tokens\")))\n",
    "    .withColumn(\"char_length\", F.length(F.col(\"clean_review\")))\n",
    "    .withColumn(\"handcrafted\", handcrafted_features_udf(F.col(\"clean_review\")))\n",
    ")\n",
    "for f in hc_fields:\n",
    "    test_feat = test_feat.withColumn(f, F.col(f\"handcrafted.{f}\"))\n",
    "test_feat = test_feat.drop(\"handcrafted\")\n",
    "test_feat = test_feat.withColumn(\n",
    "    \"codemix_ratio\",\n",
    "    F.when(F.col(\"bengali_chars\") > 0, F.col(\"latin_chars\") / F.col(\"bengali_chars\")).otherwise(0.0)\n",
    ")\n",
    "for flag in ['has_url', 'has_phone', 'has_price', 'has_promo', 'has_emoji']:\n",
    "    base = flag.replace('has_', '')\n",
    "    test_feat = test_feat.withColumn(flag, (F.col(f\"{base}_count\") > 0).cast(IntegerType()))\n",
    "\n",
    "test_feat.write.mode(\"overwrite\").parquet(str(PROCESSED_DIR / \"bfrd_test_features.parquet\"))\n",
    "\n",
    "print(\"Feature-enriched data saved\")"
   ]

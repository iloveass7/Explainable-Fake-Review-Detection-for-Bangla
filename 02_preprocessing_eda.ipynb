   "source": [
    "# ============================================================\n",
    "# 5. EXACT & NEAR-DUPLICATE DETECTION (MinHash LSH prep)\n",
    "# ============================================================\n",
    "# For exact duplicates: group by clean_review\n",
    "from pyspark.sql import functions as F\n",
    "\n",
    "print(\"Computing exact duplicate clusters...\")\n",
    "\n",
    "gold_exact_dup = (gold_feat\n",
    "    .groupBy(\"clean_review\")\n",
    "    .agg(F.count(\"*\").alias(\"exact_dup_count\"),\n",
    "         F.collect_list(\"review_id\").alias(\"dup_ids\"))\n",
    "    .filter(F.col(\"exact_dup_count\") > 1)\n",
    ")\n",
    "\n",
    "gold_exact_dup_count = gold_exact_dup.count()\n",
    "print(f\"Gold exact duplicate groups: {gold_exact_dup_count}\")\n",
    "\n",
    "bangrev_exact_dup = (bangrev_feat\n",
    "    .groupBy(\"clean_review\")\n",
    "    .agg(F.count(\"*\").alias(\"exact_dup_count\"),\n",
    "         F.collect_list(\"review_id\").alias(\"dup_ids\"))\n",
    "    .filter(F.col(\"exact_dup_count\") > 1)\n",
    ")\n",
    "\n",
    "bangrev_exact_dup_count = bangrev_exact_dup.count()\n",
    "print(f\"BanglishRev exact duplicate groups: {bangrev_exact_dup_count}\")\n",
    "\n",
    "# Add exact duplicate flag and cluster size to main DFs\n",
    "gold_dup_info = gold_exact_dup.select(\n",
    "    F.explode(\"dup_ids\").alias(\"review_id\"),\n",
    "    F.col(\"exact_dup_count\").alias(\"exact_dup_cluster_size\")\n",
    ")\n",
    "gold_feat = gold_feat.join(gold_dup_info, \"review_id\", \"left\")\n",
    "    .fillna({ \"exact_dup_cluster_size\": 1 })\n",
    "    .withColumn(\"is_exact_duplicate\", (F.col(\"exact_dup_cluster_size\") > 1).cast(IntegerType()))\n",
    "\n",
    "bangrev_dup_info = bangrev_exact_dup.select(\n",
    "    F.explode(\"dup_ids\").alias(\"review_id\"),\n",
    "    F.col(\"exact_dup_count\").alias(\"exact_dup_cluster_size\")\n",
    ")\n",
    "bangrev_feat = bangrev_feat.join(bangrev_dup_info, \"review_id\", \"left\")\n",
    "    .fillna({ \"exact_dup_cluster_size\": 1 })\n",
    "    .withColumn(\"is_exact_duplicate\", (F.col(\"exact_dup_cluster_size\") > 1).cast(IntegerType()))"
   ]
  },
  {

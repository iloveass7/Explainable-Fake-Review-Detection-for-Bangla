   "source": [
    "# ============================================================\n",
    "# 1. BANGLA-AWARE PREPROCESSING UDFs\n",
    "# ============================================================\n",
    "# Regex patterns\n",
    "URL_RE = re.compile(r'https?://\\S+|www\\.\\S+')\n",
    "PHONE_RE = re.compile(r'(\\+?88)?01[3-9]\\d{8}')\n",
    "PRICE_RE = re.compile(r'(?:৳|TK|Tk|tk|BDT)\\s*\\d+(?:[.,]\\d+)?|\\d+(?:[.,]\\d+)?\\s*(?:৳|TK|Tk|tk|BDT)')\n",
    "EMAIL_RE = re.compile(r'\\S+@\\S+\\.\\S+')\n",
    "HASHTAG_RE = re.compile(r'#\\w+')\n",
    "MENTION_RE = re.compile(r'@\\w+')\n",
    "EXCLAMATION_RE = re.compile(r'!+')\n",
    "REPEATED_CHAR_RE = re.compile(r'(.)\\1{2,}')  # 3+ repeated chars\n",
    "\n",
    "# Bangla Unicode ranges\n",
    "BENGALI_RANGE = r'\\u0980-\\u09FF'\n",
    "LATIN_RANGE = r'a-zA-Z'\n",
    "DIGIT_RANGE = r'0-9\\u09E6-\\u09EF'\n",
    "\n",
    "def count_patterns(text, pattern):\n",
    "    if text is None:\n",
    "        return 0\n",
    "    return len(pattern.findall(text))\n",
    "\n",
    "def extract_emoji(text):\n",
    "    if text is None:\n",
    "        return []\n",
    "    return [c for c in text if c in emoji.EMOJI_DATA]\n",
    "\n",
    "def char_composition(text):\n",
    "    \"\"\"Return counts of Bengali, Latin, digit, other chars.\"\"\"\n",
    "    if text is None:\n",
    "        return (0, 0, 0, 0)\n",
    "    bengali = len(re.findall(f'[{BENGALI_RANGE}]', text))\n",
    "    latin = len(re.findall(f'[{LATIN_RANGE}]', text))\n",
    "    digit = len(re.findall(f'[{DIGIT_RANGE}]', text))\n",
    "    other = len(text) - bengali - latin - digit\n",
    "    return (bengali, latin, digit, other)\n",
    "\n",
    "# Promotional keywords (Bangla + English)\n",
    "PROMO_KEYWORDS = [\n",
    "    'discount', 'offer', 'sale', 'deal', 'coupon', 'promo', 'cashback',\n",
    "    'free shipping', 'buy now', 'limited time', 'best price', 'lowest price',\n",
    "    'কিংবদন্তি', 'সেরা', 'সর্বোত্তম', 'ডিসকাউন্ট', 'অফার', 'সেল', 'প্রোমো',\n",
    "    'ক্যাশব্যাক', 'ফ্রি', 'মূল্য', 'কম দাম', 'সস্তা', 'বিশেষ', 'লিমিটেড'\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 2. PANDAS UDF FOR BATCHED PREPROCESSING\n",
    "# ============================================================\n",
    "from pyspark.sql.functions import pandas_udf, PandasUDFType\n",
    "\n",
    "@pandas_udf(StringType())\n",
    "def clean_text_udf(texts: pd.Series) -> pd.Series:\n",
    "    \"\"\"Normalize Unicode, clean control chars, preserve meaningful punctuation.\"\"\"\n",
    "    def clean_one(t):\n",
    "        if pd.isna(t):\n",
    "            return \"\"\n",
    "        # Unicode NFC normalization\n",
    "        t = unicodedata.normalize('NFC', str(t))\n",
    "        # Remove control characters except newline/tab\n",
    "        t = ''.join(ch for ch in t if ch == '\\n' or ch == '\\t' or unicodedata.category(ch)[0] != 'C')\n",
    "        # Normalize whitespace\n",
    "        t = re.sub(r'\\s+', ' ', t)\n",
    "        return t.strip()\n",
    "    import unicodedata\n",
    "    return texts.apply(clean_one)\n",
    "\n",
    "@pandas_udf(ArrayType(StringType()))\n",
    "def tokenize_bangla_udf(texts: pd.Series) -> pd.Series:\n",
    "    \"\"\"Bangla-aware tokenization using bnlp-toolkit.\"\"\"\n",
    "    try:\n",
    "        from bnlp import BengaliTokenizer\n",
    "        tokenizer = BengaliTokenizer()\n",
    "        def tok(t):\n",
    "            if pd.isna(t) or not t.strip():\n",
    "                return []\n",
    "            return tokenizer.tokenize(t)\n",
    "    except Exception as e:\n",
    "        # Fallback: simple whitespace + punctuation split\n",
    "        def tok(t):\n",
    "            if pd.isna(t) or not t.strip():\n",
    "                return []\n",
    "            return re.findall(r'\\w+|[\\u0980-\\u09FF]+|[!.?,।]', t)\n",
    "    return texts.apply(tok)\n",
    "\n",
    "@pandas_udf(StructType([\n",
    "    StructField(\"url_count\", IntegerType()),\n",
    "    StructField(\"phone_count\", IntegerType()),\n",
    "    StructField(\"price_count\", IntegerType()),\n",
    "    StructField(\"email_count\", IntegerType()),\n",
    "    StructField(\"hashtag_count\", IntegerType()),\n",
    "    StructField(\"mention_count\", IntegerType()),\n",
    "    StructField(\"exclamation_count\", IntegerType()),\n",
    "    StructField(\"emoji_count\", IntegerType()),\n",
    "    StructField(\"promo_keyword_hits\", IntegerType()),\n",
    "    StructField(\"bengali_chars\", IntegerType()),\n",
    "    StructField(\"latin_chars\", IntegerType()),\n",
    "    StructField(\"digit_chars\", IntegerType()),\n",
    "    StructField(\"other_chars\", IntegerType()),\n",
    "    StructField(\"repeated_char_ratio\", DoubleType()),\n",
    "]))\n",
    "def handcrafted_features_udf(texts: pd.Series) -> pd.Series:\n",
    "    \"\"\"Extract all handcrafted features in one pass.\"\"\"\n",
    "    def compute_all(t):\n",
    "        if pd.isna(t):\n",
    "            t = \"\"\n",
    "        url_c = count_patterns(t, URL_RE)\n",
    "        phone_c = count_patterns(t, PHONE_RE)\n",
    "        price_c = count_patterns(t, PRICE_RE)\n",
    "        email_c = count_patterns(t, EMAIL_RE)\n",
    "        hashtag_c = count_patterns(t, HASHTAG_RE)\n",
    "        mention_c = count_patterns(t, MENTION_RE)\n",
    "        excl_c = count_patterns(t, EXCLAMATION_RE)\n",
    "        emoji_c = len(extract_emoji(t))\n",
    "        \n",
    "        # Promo keywords (case-insensitive)\n",
    "        t_lower = t.lower()\n",
    "        promo_hits = sum(1 for kw in PROMO_KEYWORDS if kw.lower() in t_lower)\n",
    "        \n",
    "        # Char composition\n",
    "        beng, lat, dig, oth = char_composition(t)\n",
    "        \n",
    "        # Repeated character ratio\n",
    "        repeated_matches = REPEATED_CHAR_RE.findall(t)\n",
    "        repeated_ratio = len(repeated_matches) / max(len(t), 1)\n",
    "        \n",
    "        return (url_c, phone_c, price_c, email_c, hashtag_c, mention_c,\n",
    "                excl_c, emoji_c, promo_hits, beng, lat, dig, oth, repeated_ratio)\n",
    "    return texts.apply(compute_all)\n",
    "\n",
    "print(\"UDFs defined\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 3. APPLY PREPROCESSING TO GOLD DATA\n",
    "# ============================================================\n",
    "print(\"Processing gold modeling data...\")\n",
    "\n",
    "gold_feat = (gold_modeling\n",
    "    .withColumn(\"clean_review\", clean_text_udf(F.col(\"review\")))\n",
    "    .withColumn(\"tokens\", tokenize_bangla_udf(F.col(\"clean_review\")))\n",
    "    .withColumn(\"token_count\", F.size(F.col(\"tokens\")))\n",
    "    .withColumn(\"char_length\", F.length(F.col(\"clean_review\")))\n",
    "    .withColumn(\"handcrafted\", handcrafted_features_udf(F.col(\"clean_review\")))\n",
    ")\n",
    "\n",
    "# Expand handcrafted struct\n",
    "hc_fields = [\"url_count\", \"phone_count\", \"price_count\", \"email_count\",\n",
    "             \"hashtag_count\", \"mention_count\", \"exclamation_count\",\n",
    "             \"emoji_count\", \"promo_keyword_hits\",\n",
    "             \"bengali_chars\", \"latin_chars\", \"digit_chars\", \"other_chars\",\n",
    "             \"repeated_char_ratio\"]\n",
    "\n",
    "for f in hc_fields:\n",
    "    gold_feat = gold_feat.withColumn(f, F.col(f\"handcrafted.{f}\"))\n",
    "\n",
    "gold_feat = gold_feat.drop(\"handcrafted\")\n",
    "\n",
    "# Code-mix ratio\n",
    "gold_feat = gold_feat.withColumn(\n",
    "    \"codemix_ratio\",\n",
    "    F.when(F.col(\"bengali_chars\") > 0, F.col(\"latin_chars\") / F.col(\"bengali_chars\")).otherwise(0.0)\n",
    ")\n",
    "\n",
    "# Binary flags\n",
    "gold_feat = gold_feat.withColumn(\"has_url\", (F.col(\"url_count\") > 0).cast(IntegerType()))\n",
    "gold_feat = gold_feat.withColumn(\"has_phone\", (F.col(\"phone_count\") > 0).cast(IntegerType()))\n",
    "gold_feat = gold_feat.withColumn(\"has_price\", (F.col(\"price_count\") > 0).cast(IntegerType()))\n",
    "gold_feat = gold_feat.withColumn(\"has_promo\", (F.col(\"promo_keyword_hits\") > 0).cast(IntegerType()))\n",
    "gold_feat = gold_feat.withColumn(\"has_emoji\", (F.col(\"emoji_count\") > 0).cast(IntegerType()))\n",
    "\n",
    "print(f\"Gold features: {gold_feat.count()} rows, {len(gold_feat.columns)} cols\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 4. APPLY PREPROCESSING TO BANGLISHREV (SAMPLE)\n",
    "# ============================================================\n",
    "print(\"Processing BanglishRev sample...\")\n",
    "\n",
    "bangrev_feat = (bangrev_unlabeled\n",
    "    .withColumn(\"clean_review\", clean_text_udf(F.col(\"review\")))\n",
    "    .withColumn(\"tokens\", tokenize_bangla_udf(F.col(\"clean_review\")))\n",
    "    .withColumn(\"token_count\", F.size(F.col(\"tokens\")))\n",
    "    .withColumn(\"char_length\", F.length(F.col(\"clean_review\")))\n",
    "    .withColumn(\"handcrafted\", handcrafted_features_udf(F.col(\"clean_review\")))\n",
    ")\n",
    "\n",
    "for f in hc_fields:\n",
    "    bangrev_feat = bangrev_feat.withColumn(f, F.col(f\"handcrafted.{f}\"))\n",
    "\n",
    "bangrev_feat = bangrev_feat.drop(\"handcrafted\")\n",
    "\n",
    "bangrev_feat = bangrev_feat.withColumn(\n",
    "    \"codemix_ratio\",\n",
    "    F.when(F.col(\"bengali_chars\") > 0, F.col(\"latin_chars\") / F.col(\"bengali_chars\")).otherwise(0.0)\n",
    ")\n",
    "\n",
    "bangrev_feat = bangrev_feat.withColumn(\"has_url\", (F.col(\"url_count\") > 0).cast(IntegerType()))\n",
    "bangrev_feat = bangrev_feat.withColumn(\"has_phone\", (F.col(\"phone_count\") > 0).cast(IntegerType()))\n",
    "bangrev_feat = bangrev_feat.withColumn(\"has_price\", (F.col(\"price_count\") > 0).cast(IntegerType()))\n",
    "bangrev_feat = bangrev_feat.withColumn(\"has_promo\", (F.col(\"promo_keyword_hits\") > 0).cast(IntegerType()))\n",
    "bangrev_feat = bangrev_feat.withColumn(\"has_emoji\", (F.col(\"emoji_count\") > 0).cast(IntegerType()))\n",
    "\n",
    "print(f\"BanglishRev features: {bangrev_feat.count()} rows\")"
   ]

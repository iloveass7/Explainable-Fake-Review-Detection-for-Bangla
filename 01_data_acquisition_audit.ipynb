   "source": [
    "# ============================================================\n",
    "# CONFIG & PATHS\n",
    "# ============================================================\n",
    "BASE_DIR = Path(\"/kaggle/working/bangla_fake_review\")\n",
    "RAW_DIR = BASE_DIR / \"raw\"\n",
    "PROCESSED_DIR = BASE_DIR / \"processed\"\n",
    "AUDIT_DIR = BASE_DIR / \"audit\"\n",
    "\n",
    "for d in [RAW_DIR, PROCESSED_DIR, AUDIT_DIR]:\n",
    "    d.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Dataset identifiers (Hugging Face)\n",
    "BFRD_REPO = \"shawon95/Bengali-Fake-Review-Dataset\"\n",
    "BANGREV_REPO = \"BanglishRev/bangla-english-and-code-mixed-ecommerce-review-dataset\"\n",
    "\n",
    "# Reproducibility\n",
    "SEED = 42\n",
    "np.random.seed(SEED)\n",
    "\n",
    "print(f\"Base: {BASE_DIR}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 1. DOWNLOAD BFRD (Gold)\n",
    "# ============================================================\n",
    "from datasets import load_dataset\n",
    "\n",
    "print(\"Downloading BFRD...\")\n",
    "bfrd_ds = load_dataset(BFRD_REPO, split=\"train\")\n",
    "print(f\"BFRD rows: {len(bfrd_ds)}\")\n",
    "print(f\"BFRD columns: {bfrd_ds.column_names}\")\n",
    "print(bfrd_ds[0])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 2. DOWNLOAD BANGLISHREV (Auxiliary)\n",
    "# ============================================================\n",
    "print(\"Downloading BanglishRev (text only, streaming)...\")\n",
    "# BanglishRev is large (1.74M rows) - use streaming to avoid OOM\n",
    "bangrev_ds = load_dataset(BANGREV_REPO, split=\"train\", streaming=True)\n",
    "\n",
    "# Peek first few rows\n",
    "for i, row in enumerate(bangrev_ds):\n",
    "    if i < 3:\n",
    "        print(f\"Row {i}: {list(row.keys())}\")\n",
    "        for k, v in row.items():\n",
    "            print(f\"  {k}: {type(v).__name__} = {str(v)[:100]}\")\n",
    "    else:\n",
    "        break"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 3. LOAD BFRD INTO SPARK WITH EXPLICIT SCHEMA\n",
    "# ============================================================\n",
    "bfrd_schema = StructType([\n",
    "    StructField(\"review\", StringType(), True),\n",
    "    StructField(\"label\", IntegerType(), True),  # 0=fake, 1=non-fake\n",\n",
    "])\n",
    "\n",
    "# Convert HF dataset to pandas then Spark (BFRD is small: 9049 rows)\n",
    "bfrd_pdf = bfrd_ds.to_pandas()\n",
    "bfrd_sdf = spark.createDataFrame(bfrd_pdf, schema=bfrd_schema)\n",
    "\n",
    "# Add stable review_id\n",
    "bfrd_sdf = bfrd_sdf.withColumn(\"review_id\", F.monotonically_increasing_id())\n",
    "bfrd_sdf = bfrd_sdf.select(\"review_id\", \"review\", \"label\")\n",
    "\n",
    "print(f\"BFRD Spark rows: {bfrd_sdf.count()}\")\n",
    "bfrd_sdf.show(5, truncate=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 4. LOAD BANGLISHREV INTO SPARK (SAMPLED FOR WEEK 1)\n",
    "# ============================================================\n",
    "# For Week 1 audit, load a manageable sample (e.g., 100k rows)\n",
    "# Full corpus processing happens in Week 3/5\n",
    "BANGREV_SAMPLE_SIZE = 100000\n",
    "\n",
    "print(f\"Sampling {BANGREV_SAMPLE_SIZE} rows from BanglishRev...\")\n",
    "bangrev_sample = []\n",
    "for i, row in enumerate(load_dataset(BANGREV_REPO, split=\"train\", streaming=True)):\n",
    "    if i >= BANGREV_SAMPLE_SIZE:\n",
    "        break\n",
    "    bangrev_sample.append(row)\n",
    "\n",
    "bangrev_pdf = pd.DataFrame(bangrev_sample)\n",
    "print(f\"BanglishRev sample columns: {bangrev_pdf.columns.tolist()}\")\n",
    "print(f\"BanglishRev sample shape: {bangrev_pdf.shape}\")\n",
    "print(bangrev_pdf.head(2).to_string())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 5. BANGLISHREV SCHEMA - ADAPT TO ACTUAL COLUMNS\n",
    "# ============================================================\n",
    "# Common fields in BanglishRev (adjust based on actual data)\n",
    "bangrev_schema = StructType([\n",
    "    StructField(\"review_text\", StringType(), True),\n",
    "    StructField(\"rating\", DoubleType(), True),\n",
    "    StructField(\"product_id\", StringType(), True),\n",
    "    StructField(\"review_date\", StringType(), True),\n",
    "    StructField(\"helpful_votes\", LongType(), True),\n",
    "    StructField(\"verified_purchase\", BooleanType(), True),\n",
    "])\n",
    "\n",
    "# Keep only columns that exist\n",
    "available_cols = [c for c in bangrev_pdf.columns if c in [f.name for f in bangrev_schema.fields]]\n",
    "bangrev_pdf = bangrev_pdf[available_cols]\n",
    "\n",
    "bangrev_sdf = spark.createDataFrame(bangrev_pdf)\n",
    "bangrev_sdf = bangrev_sdf.withColumn(\"review_id\", F.monotonically_increasing_id() + 1000000)\n",
    "bangrev_sdf = bangrev_sdf.withColumn(\"source_dataset\", F.lit(\"BanglishRev\"))\n",
    "bangrev_sdf = bangrev_sdf.withColumn(\"label_source\", F.lit(\"unlabeled\"))\n",
    "\n",
    "print(f\"BanglishRev Spark rows: {bangrev_sdf.count()}\")\n",
    "bangrev_sdf.show(5, truncate=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 6. AUDIT FUNCTION\n",
    "# ============================================================\n",
    "def audit_dataframe(sdf, name, audit_dir):\n",
    "    \"\"\"Comprehensive audit of a Spark DataFrame.\"\"\"\n",
    "    audit = {}\n",
    "    audit[\"name\"] = name\n",
    "    audit[\"timestamp\"] = datetime.now().isoformat()\n",
    "    audit[\"row_count\"] = sdf.count()\n",
    "    audit[\"columns\"] = sdf.columns\n",
    "    \n",
    "    # Null counts\n",
    "    null_counts = sdf.select([F.count(F.when(F.col(c).isNull(), c)).alias(c) for c in sdf.columns]).collect()[0].asDict()\n",
    "    audit[\"null_counts\"] = null_counts\n",
    "    \n",
    "    # Distinct counts (for non-text columns)\n",
    "    distinct_counts = {}\n",
    "    for c in sdf.columns:\n",
    "        if sdf.schema[c].dataType != StringType() or c in [\"label\", \"source_dataset\", \"label_source\"]:\n",
    "            try:\n",
    "                distinct_counts[c] = sdf.select(c).distinct().count()\n",
    "            except:\n",
    "                pass\n",
    "    audit[\"distinct_counts\"] = distinct_counts\n",
    "    \n    # Duplicate review_ids\n",
    "    if \"review_id\" in sdf.columns:\n",
    "        dup_count = sdf.groupBy(\"review_id\").count().filter(F.col(\"count\") > 1).count()\n",
    "        audit[\"duplicate_review_ids\"] = dup_count\n",
    "    \n    # Exact duplicate rows (on all columns)\n",
    "    total = audit[\"row_count\"]\n",
    "    distinct = sdf.distinct().count()\n",
    "    audit[\"exact_duplicate_rows\"] = total - distinct\n",
    "    \n    # Save audit\n",
    "    audit_path = audit_dir / f\"audit_{name}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json\"\n",
    "    with open(audit_path, 'w') as f:\n",
    "        json.dump(audit, f, indent=2, default=str)\n",
    "    \n    print(f\"=== {name} AUDIT ===\")\n",
    "    print(f\"  Rows: {audit['row_count']}\")\n",
    "    print(f\"  Nulls: {audit['null_counts']}\")\n",
    "    print(f\"  Distinct: {audit['distinct_counts']}\")\n",
    "    print(f\"  Duplicate IDs: {audit.get('duplicate_review_ids', 0)}\")\n",
    "    print(f\"  Exact duplicate rows: {audit['exact_duplicate_rows']}\")\n",
    "    print(f\"  Saved: {audit_path}\")\n",
    "    \n    return audit\n",
    "\n",
    "bfrd_audit = audit_dataframe(bfrd_sdf, \"BFRD\", AUDIT_DIR)\n",
    "bangrev_audit = audit_dataframe(bangrev_sdf, \"BanglishRev_sample\", AUDIT_DIR)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 7. BFRD CLEANING & DEDUPLICATION\n",
    "# ============================================================\n",
    "print(\"Cleaning BFRD...\")\n",
    "\n",
    "# Remove null reviews or labels\n",
    "bfrd_clean = bfrd_sdf.filter(\n",
    "    (F.col(\"review\").isNotNull()) & \n",
    "    (F.col(\"label\").isNotNull()) & \n",
    "    (F.trim(F.col(\"review\")) != \"\")\n",
    ")\n",
    "\n",
    "# Remove exact duplicate review texts (keep first)\n",
    "bfrd_clean = bfrd_clean.dropDuplicates([\"review\"])\n",
    "\n",
    "# Verify label distribution\n",
    "label_dist = bfrd_clean.groupBy(\"label\").count().collect()\n",
    "for row in label_dist:\n",
    "    print(f\"  Label {row['label']}: {row['count']} ({row['count']/bfrd_clean.count()*100:.1f}%)\")\n",
    "\n",
    "print(f\"BFRD after cleaning: {bfrd_clean.count()} rows\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# ============================================================\n",
    "# 8. STRATIFIED SPLIT (70/15/15) - LEAKAGE SAFE\n",
    "# ============================================================\n",
    "# Add a hash-based split column for reproducibility\n",
    "bfrd_split = bfrd_clean.withColumn(\n",
    "    \"split_hash\",\n",
    "    F.xxhash64(F.col(\"review_id\"), F.lit(SEED))\n",
    ")\n",
    "\n",
    "# Stratified split using hash modulo\n",
    "train_df = bfrd_split.filter(F.col(\"split_hash\") % 100 < 70)\n",
    "val_df = bfrd_split.filter((F.col(\"split_hash\") % 100 >= 70) & (F.col(\"split_hash\") % 100 < 85))\n",
    "test_df = bfrd_split.filter(F.col(\"split_hash\") % 100 >= 85)\n",
    "\n",
    "# Add split metadata\n",
    "train_df = train_df.withColumn(\"source_split\", F.lit(\"train\")).drop(\"split_hash\")\n",
    "val_df = val_df.withColumn(\"source_split\", F.lit(\"validation\")).drop(\"split_hash\")\n",
    "test_df = test_df.withColumn(\"source_split\", F.lit(\"test\")).drop(\"split_hash\")\n",
    "\n",
    "# Lock test set - save separately and DON'T touch again until final evaluation\n",
    "test_df.write.mode(\"overwrite\").parquet(str(PROCESSED_DIR / \"bfrd_test_locked.parquet\"))\n",
    "\n",
    "# Save train/val for modeling\n",
    "train_df.write.mode(\"overwrite\").parquet(str(PROCESSED_DIR / \"bfrd_train.parquet\"))\n",
    "val_df.write.mode(\"overwrite\").parquet(str(PROCESSED_DIR / \"bfrd_val.parquet\"))\n",
    "\n",
    "for name, df in [(\"train\", train_df), (\"val\", val_df), (\"test\", test_df)]:\n",
    "    dist = df.groupBy(\"label\").count().collect()\n",
    "    print(f\"{name}: {df.count()} rows\")\n",
    "    for r in dist:\n",
    "        print(f\"  Label {r['label']}: {r['count']}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 9. BANGLISHREV CLEANING (SAMPLE)\n",
    "# ============================================================\n",
    "print(\"Cleaning BanglishRev sample...\")\n",
    "\n",
    "# Keep only text reviews\n",
    "text_col = \"review_text\" if \"review_text\" in bangrev_sdf.columns else \"review\"\n",
    "\n",
    "bangrev_clean = bangrev_sdf.filter(\n",
    "    (F.col(text_col).isNotNull()) & \n",
    "    (F.trim(F.col(text_col)) != \"\")\n",
    ").withColumnRenamed(text_col, \"review\")\n",
    "\n",
    "# Drop exact duplicate review texts\n",
    "bangrev_clean = bangrev_clean.dropDuplicates([\"review\"])\n",
    "\n",
    "# Add source_split for tracking\n",
    "bangrev_clean = bangrev_clean.withColumn(\"source_split\", F.lit(\"unlabeled_pool\"))\n",
    "\n",
    "bangrev_clean.write.mode(\"overwrite\").parquet(str(PROCESSED_DIR / \"bangrev_sample.parquet\"))\n",
    "\n",
    "print(f\"BanglishRev cleaned: {bangrev_clean.count()} rows\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 10. UNIFIED PROVENANCE TABLE\n",
    "# ============================================================\n",
    "# Create a unified view with consistent columns for downstream use\n",
    "def standardize_columns(df, source_name, split_name):\n",
    "    return df.select(\n",
    "        F.col(\"review_id\"),\n",
    "        F.col(\"review\"),\n",
    "        F.col(\"label\"),\n",
    "        F.lit(source_name).alias(\"source_dataset\"),\n",
    "        F.lit(split_name).alias(\"source_split\"),\n",
    "        F.lit(\"gold\" if source_name == \"BFRD\" else \"unlabeled\").alias(\"label_source\"),\n",
    "        F.lit(None).cast(DoubleType()).alias(\"confidence_score\")\n",
    "    )\n",
    "\n",
    "bfrd_train_std = standardize_columns(train_df, \"BFRD\", \"train\")\n",
    "bfrd_val_std = standardize_columns(val_df, \"BFRD\", \"validation\")\n",
    "bfrd_test_std = standardize_columns(test_df, \"BFRD\", \"test\")\n",
    "bangrev_std = standardize_columns(bangrev_clean, \"BanglishRev\", \"unlabeled_pool\")\n",
    "\n",
    "# Combine train + val for modeling (test stays locked)\n",
    "gold_modeling = bfrd_train_std.unionByName(bfrd_val_std)\n",
    "\n",
    "gold_modeling.write.mode(\"overwrite\").parquet(str(PROCESSED_DIR / \"bfrd_gold_modeling.parquet\"))\n",
    "bangrev_std.write.mode(\"overwrite\").parquet(str(PROCESSED_DIR / \"bangrev_unlabeled.parquet\"))\n",
    "\n",
    "print(f\"Gold modeling (train+val): {gold_modeling.count()}\")\n",
    "print(f\"BanglishRev unlabeled: {bangrev_std.count()}\")\n",
    "print(f\"Test (LOCKED): {bfrd_test_std.count()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 11. SPLIT INTEGRITY CHECK (NO LEAKAGE)\n",
    "# ============================================================\n",
    "print(\"=== SPLIT INTEGRITY CHECK ===\")\n",
    "\n",
    "# Check review_id overlap between splits\n",
    "train_ids = set(train_df.select(\"review_id\").rdd.flatMap(lambda x: x).collect())\n",
    "val_ids = set(val_df.select(\"review_id\").rdd.flatMap(lambda x: x).collect())\n",
    "test_ids = set(test_df.select(\"review_id\").rdd.flatMap(lambda x: x).collect())\n",
    "\n",
    "print(f\"Train-Val overlap: {len(train_ids & val_ids)}\")\n",
    "print(f\"Train-Test overlap: {len(train_ids & test_ids)}\")\n",
    "print(f\"Val-Test overlap: {len(val_ids & test_ids)}\")\n",
    "\n",
    "# Check review text overlap (more important)\n",
    "train_texts = set(train_df.select(\"review\").rdd.flatMap(lambda x: x).collect())\n",
    "val_texts = set(val_df.select(\"review\").rdd.flatMap(lambda x: x).collect())\n",
    "test_texts = set(test_df.select(\"review\").rdd.flatMap(lambda x: x).collect())\n",
    "\n",
    "print(f\"Train-Val text overlap: {len(train_texts & val_texts)}\")\n",
    "print(f\"Train-Test text overlap: {len(train_texts & test_texts)}\")\n",
    "print(f\"Val-Test text overlap: {len(val_texts & test_texts)}\")\n",
    "\n",
    "# Verify test set is truly locked\n",
    "test_locked = spark.read.parquet(str(PROCESSED_DIR / \"bfrd_test_locked.parquet\"))\n",
    "print(f\"Test locked file rows: {test_locked.count()}\")\n",
    "assert test_locked.count() == test_df.count(), \"Test set mismatch!\""
   ]
  },

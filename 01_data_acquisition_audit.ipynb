    "# ============================================================\n",
    "# 13. QUICK SPARK SQL DEMO FOR AUDITING\n",
    "# ============================================================\n",
    "gold_modeling.createOrReplaceTempView(\"gold_modeling\")\n",
    "bangrev_std.createOrReplaceTempView(\"bangrev_unlabeled\")\n",
    "\n",
    "# Class balance\n",
    "spark.sql(\"\"\"\n",
    "SELECT label, COUNT(*) as cnt, ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 2) as pct\n",
    "FROM gold_modeling\n",
    "GROUP BY label\n",
    "\"\"\").show()\n",
    "\n",
    "# Source summary\n",
    "spark.sql(\"\"\"\n",
    "SELECT source_dataset, source_split, label_source, COUNT(*) as cnt\n",
    "FROM gold_modeling\n",
    "GROUP BY source_dataset, source_split, label_source\n",
    "UNION ALL\n",
    "SELECT source_dataset, source_split, label_source, COUNT(*) as cnt\n",
    "FROM bangrev_unlabeled\n",
    "GROUP BY source_dataset, source_split, label_source\n",
    "\"\"\").show()"
   ]

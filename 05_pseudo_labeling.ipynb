    "# ============================================================\n",
    "# Primary: best macro-F1 on validation\n",
    "best_expanded = max(comparison, key=lambda x: x[\"exp_macro_f1\"])\n",
    "best_model_name = best_expanded[\"model\"]\n",
    \n",
    "print(f\"\\nBest expanded model: {best_model_name}\")\n",
    "print(f"  Gold Macro-F1: {best_expanded['gold_macro_f1']:.4f} -> Expanded: {best_expanded['exp_macro_f1']:.4f} (Δ={best_expanded['delta_f1']:+.4f})\")\n",
    "print(f"  Gold PR-AUC: {best_expanded['gold_pr_auc']:.4f} -> Expanded: {best_expanded['exp_pr_auc']:.4f} (Δ={best_expanded['delta_pr_auc']:+.4f})\")\n",
    "\n",
    "final_model = expanded_models[best_model_name]\n",
    "final_model.write().overwrite().save(str(MODELS_DIR / \"final_model\"))\n",
    "\n",
    "# Also save the gold-only version for comparison on test\n",
    "final_gold_model = gold_models[best_model_name]\n",
    "final_gold_model.write().overwrite().save(str(MODELS_DIR / \"final_model_gold_only\"))"

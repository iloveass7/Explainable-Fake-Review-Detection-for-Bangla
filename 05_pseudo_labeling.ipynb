    "# ============================================================\n",
    "# 9. SENSITIVITY CHECK: THRESHOLD 0.95\n",
    "# ============================================================\n",
    "print(\"=== SENSITIVITY: Threshold 0.95 ===\")\n",
    "\n",
    "accepted_95 = bangrev_pseudo.filter(F.col(\"max_prob\") > 0.95)\n",
    "print(f\"Accepted at 0.95: {accepted_95.count()}\")\n",
    "\n",
    "if accepted_95.count() > 100:\n",
    "    pseudo_95 = accepted_95.select(\n",
    "        \"review_id\", \"review\",\n",
    "        F.col(\"pseudo_label\").alias(\"label\"),\n",
    "        \"source_dataset\",\n",
    "        F.lit(\"pseudo_train_95\").alias(\"source_split\"),\n",
    "        F.lit(\"pseudo\").alias(\"label_source\"),\n",
    "        \"confidence_score\",\n",
    "        \"features_linear\", \"features_tree\", \"features_nb\"\n",
    "    ).withColumn(\"sample_weight\", F.lit(PSEUDO_WEIGHT))\n",
    "    \n",
    "    expanded_95 = gold_train.withColumn(\"sample_weight\", F.lit(1.0)).unionByName(pseudo_95)\n",
    "    \n",
    "    # Quick LR retrain\n",
    "    lr_95 = LogisticRegression(\n",
    "        featuresCol=\"features_linear\", labelCol=\"label\",\n",
    "        weightCol=\"sample_weight\", maxIter=100, regParam=0.1\n",
    "    ).fit(expanded_95)\n",
    "    \n    "    val_pred_95 = lr_95.transform(val)\n",
    "    m_95 = evaluate_model(val_pred_95, \"LR_Expanded_95\")\n",
    "    print(f\"LR 0.95: Macro-F1={m_95['macro_f1']:.4f}, PR-AUC={m_95['pr_auc']:.4f}\")\n",
    "else:\n",
    "    print(\"Not enough pseudo-labels at 0.95 threshold\")"
   ]

    "# ============================================================\n",
    "# 8. COMPARISON: GOLD-ONLY VS EXPANDED\n",
    "# ============================================================\n",
    "comparison = []\n",
    "\n",
    "gold_models = {\n",
    "    \"LR\": lr_gold,\n",
    "    \"NB\": NaiveBayesModel.load(str(MODELS_DIR / \"nb_best\")),\n",
    "    \"SVC\": LinearSVCModel.load(str(MODELS_DIR / \"svc_best\")),\n",
    "    \"RF\": RandomForestClassificationModel.load(str(MODELS_DIR / \"rf_best\")),\n",
    "    \"GBT\": GBTClassificationModel.load(str(MODELS_DIR / \"gbt_best\")),\n",
    "}\n",
    "\n",
    "expanded_models = {\n",
    "    \"LR\": lr_expanded,\n",
    "    \"NB\": nb_expanded,\n",
    "    \"SVC\": svc_expanded,\n",
    "    \"RF\": rf_expanded,\n",
    "    \"GBT\": gbt_expanded,\n",
    "}\n",
    "\n",
    "for name in gold_models:\n",
    "    gold_pred = gold_models[name].transform(val)\n",
    "    exp_pred = expanded_models[name].transform(val)\n",
    "    \n",
    "    gold_m = evaluate_model(gold_pred, f\"{name}_Gold\")\n",
    "    exp_m = evaluate_model(exp_pred, f\"{name}_Expanded\")\n",
    "    \n",
    "    comparison.append({\n",
    "        \"model\": name,\n",
    "        \"gold_macro_f1\": gold_m[\"macro_f1\"],\n",
    "        \"exp_macro_f1\": exp_m[\"macro_f1\"],\n",
    "        \"gold_pr_auc\": gold_m[\"pr_auc\"],\n",
    "        \"exp_pr_auc\": exp_m[\"pr_auc\"],\n",
    "        \"delta_f1\": exp_m[\"macro_f1\"] - gold_m[\"macro_f1\"],\n",
    "        \"delta_pr_auc\": exp_m[\"pr_auc\"] - gold_m[\"pr_auc\"]\n",
    "    })"

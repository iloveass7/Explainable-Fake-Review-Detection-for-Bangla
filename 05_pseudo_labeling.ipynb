   "source": [
    "# ============================================================\n",
    "# PATHS & LOAD DATA\n",
    "# ============================================================\n",
    "BASE_DIR = Path(\"/kaggle/working/bangla_fake_review\")\n",
    "PROCESSED_DIR = BASE_DIR / \"processed\"\n",
    "MODELS_DIR = BASE_DIR / \"models\"\n",
    "RESULTS_DIR = BASE_DIR / \"results\"\n",
    "AUDIT_DIR = BASE_DIR / \"audit\"\n",
    "\n",
    "# Gold data\n",
    "train = spark.read.parquet(str(PROCESSED_DIR / \"train_model_ready.parquet\"))\n",
    "val = spark.read.parquet(str(PROCESSED_DIR / \"val_model_ready.parquet\"))\n",
    "test = spark.read.parquet(str(PROCESSED_DIR / \"test_model_ready.parquet\"))\n",
    "\n",
    "# BanglishRev (full or sample - use model_ready from Week 3)\n",
    "bangrev = spark.read.parquet(str(PROCESSED_DIR / \"bangrev_model_ready.parquet\"))\n",
    "\n",
    "print(f\"Train: {train.count()}\")\n",
    "print(f\"Val: {val.count()}\")\n",
    "print(f\"Test: {test.count()}\")\n",
    "print(f\"BanglishRev: {bangrev.count()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 1. LOAD LR MODEL FOR PSEUDO-LABELING\n",
    "# ============================================================\n",
    "from pyspark.ml.classification import LogisticRegressionModel\n",
    "\n",
    "lr_model = LogisticRegressionModel.load(str(MODELS_DIR / \"lr_for_pseudo\"))\n",
    "\n",
    "# Check it has probability output\n",
    "print(f\"LR Model: features={lr_model.getFeaturesCol()}, prob={lr_model.getProbabilityCol()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 2. GENERATE PSEUDO-LABELS ON BANGLISHREV\n",
    "# ============================================================\n",
    "CONFIDENCE_THRESHOLD = 0.90\n",
    "\n",
    "print(f\"Generating pseudo-labels with threshold > {CONFIDENCE_THRESHOLD}...\")\n",
    "\n",
    "# Predict on BanglishRev\n",
    "bangrev_pred = lr_model.transform(bangrev)\n",
    "\n",
    "# Extract max probability and predicted class\n",
    "bangrev_pseudo = bangrev_pred.withColumn(\n",
    "    \"prob_fake\", F.col(\"probability\")[0]\n",
    ").withColumn(\n",
    "    \"prob_genuine\", F.col(\"probability\")[1]\n",
    ").withColumn(\n",
    "    \"max_prob\", F.greatest(F.col(\"prob_fake\"), F.col(\"prob_genuine\"))\n",
    ").withColumn(\n",
    "    \"pseudo_label\", F.when(F.col(\"prob_genuine\") > F.col(\"prob_fake\"), 1).otherwise(0)\n",
    ").withColumn(\n",
    "    \"confidence_score\", F.col(\"max_prob\")\n",
    ")\n",
    "\n",
    "# Filter by confidence threshold\n",
    "accepted = bangrev_pseudo.filter(F.col(\"max_prob\") > CONFIDENCE_THRESHOLD)\n",
    "rejected = bangrev_pseudo.filter(F.col(\"max_prob\") <= CONFIDENCE_THRESHOLD)\n",
    "\n",
    "print(f\"Total BanglishRev: {bangrev_pseudo.count()}\")\n",
    print(f"Accepted (>{CONFIDENCE_THRESHOLD}): {accepted.count()}\")\n",
    "print(f"Rejected: {rejected.count()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 3. AUDIT PSEUDO-LABELS\n",
    "# ============================================================\n",
    "print(\"=== PSEUDO-LABEL AUDIT ===\")\n",
    "\n",
    "# Class distribution\n",
    "pseudo_dist = accepted.groupBy(\"pseudo_label\").count().collect()\n",
    "for r in pseudo_dist:\n",
    "    print(f\"  Pseudo-label {r['pseudo_label']}: {r['count']} ({r['count']/accepted.count()*100:.1f}%)\")\n",
    "\n",
    "# Confidence distribution\n",
    "conf_stats = accepted.select(\n",
    "    F.mean(\"confidence_score\").alias(\"mean_conf\"),\n",
    "    F.min(\"confidence_score\").alias(\"min_conf\"),\n",
    "    F.max(\"confidence_score\").alias(\"max_conf\"),\n",
    "    F.percentile_approx(\"confidence_score\", 0.5).alias(\"median_conf\")\n",
    ").collect()[0]\n",
    "print(f\"Confidence: mean={conf_stats['mean_conf']:.4f}, median={conf_stats['median_conf']:.4f}\")\n",
    "\n",
    "# Source split distribution\n",
    "split_dist = accepted.groupBy(\"source_split\").count().collect()\n",
    "for r in split_dist:\n",
    "    print(f\"  {r['source_split']}: {r['count']}\")\n",
    "\n",
    "# Check if pseudo-labels overwhelm gold\n",
    "gold_train_count = train.count()\n",
    "pseudo_count = accepted.count()\n",
    "ratio = pseudo_count / gold_train_count if gold_train_count > 0 else float('inf')\n",
    "print(f\"\\nGold train: {gold_train_count}, Pseudo: {pseudo_count}, Ratio: {ratio:.2f}\")\n",
    "\n",
    "if ratio > 5:\n",
    "    print(\"WARNING: Pseudo-labels significantly exceed gold data. Consider capping.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 4. PREPARE PSEUDO-LABELED DATA FOR TRAINING\n",
    "# ============================================================\n",
    "# Standardize columns to match gold data\n",
    "pseudo_train = accepted.select(\n",
    "    F.col(\"review_id\"),\n",
    "    F.col(\"review\"),\n",
    "    F.col(\"pseudo_label\").alias(\"label\"),\n",
    "    F.col(\"source_dataset\"),\n",
    "    F.lit(\"pseudo_train\").alias(\"source_split\"),\n",
    "    F.lit(\"pseudo\").alias(\"label_source\"),\n",
    "    F.col(\"confidence_score\"),\n",
    "    F.col(\"features_linear\"),\n",
    "    F.col(\"features_tree\"),\n",
    "    F.col(\"features_nb\")\n",
    ")\n",
    "\n",
    "# Gold train + val (no test!)\n",
    "gold_train = train.select(\n",
    "    \"review_id\", \"review\", \"label\", \"source_dataset\", \"source_split\",\n",
    "    \"label_source\", \"confidence_score\", \"features_linear\",\n",
    "    \"features_tree\", \"features_nb\"\n",
    ")\n",
    "\n",
    "gold_val = val.select(\n",
    "    \"review_id\", \"review\", \"label\", \"source_dataset\", \"source_split\",\n",
    "    \"label_source\", \"confidence_score\", \"features_linear\",\n",
    "    \"features_tree\", \"features_nb\"\n",
    ")\n",
    "\n",
    "# Combine: gold train + pseudo train\n",
    "expanded_train = gold_train.unionByName(pseudo_train)\n",
    "\n",
    "print(f\"Gold train: {gold_train.count()}\")\n",
    "print(f"Pseudo train: {pseudo_train.count()}\")\n",
    "print(f"Expanded train: {expanded_train.count()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 5. ADD SAMPLE WEIGHTS (lower weight for pseudo-labels)\n",
    "# ============================================================\n",
    "# Weight = 1.0 for gold, 0.5 for pseudo (adjustable)\n",
    "PSEUDO_WEIGHT = 0.5\n",
    "\n",
    "expanded_train = expanded_train.withColumn(\n",
    "    \"sample_weight\",\n",
    "    F.when(F.col(\"label_source\") == \"pseudo\", PSEUDO_WEIGHT).otherwise(1.0)\n",
    ")\n",
    "\n",
    "gold_train = gold_train.withColumn(\"sample_weight\", F.lit(1.0))\n",
    "\n",
    "print(f"Weight distribution: {expanded_train.groupBy('sample_weight').count().collect()}")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# 6. RETRAIN ALL MODELS ON EXPANDED TRAINING SET\n",
    "# ============================================================\n",
    "\n",
    "def evaluate_model(predictions, name):\n",
    "    macro_f1 = MulticlassClassificationEvaluator(\n",
    "        labelCol=\"label\", predictionCol=\"prediction\", metricName=\"f1\"\n",
    "    ).evaluate(predictions)\n",
    "    pr_auc = BinaryClassificationEvaluator(\n",
    "        labelCol=\"label\", rawPredictionCol=\"rawPrediction\", metricName=\"areaUnderPR\"\n",
    "    ).evaluate(predictions)\n",
    "    accuracy = MulticlassClassificationEvaluator(\n",
    "        labelCol=\"label\", predictionCol=\"prediction\", metricName=\"accuracy\"\n",
    "    ).evaluate(predictions)\n",
    "    roc_auc = BinaryClassificationEvaluator(\n",
    "        labelCol=\"label\", rawPredictionCol=\"rawPrediction\", metricName=\"areaUnderROC\"\n",
    "    ).evaluate(predictions)\n",
    "    \n",
    "    # Per-class\n",
    "    cls_metrics = {}\n",
    "    for cls in [0, 1]:\n",
    "        cls_metrics[f\"class_{cls}_f1\"] = MulticlassClassificationEvaluator(\n",
    "            labelCol=\"label\", predictionCol=\"prediction\",\n",
    "            metricName=\"f1ByLabel\", metricLabel=cls\n",
    "        ).evaluate(predictions)\n",
    "    \n",
    "    return {\n",
    "        \"model\": name,\n",
    "        \"macro_f1\": macro_f1,\n",
    "        \"pr_auc\": pr_auc,\n",
    "        \"accuracy\": accuracy,\n",
    "        \"roc_auc\": roc_auc,\n",
    "        **cls_metrics\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Logistic Regression (with CV) ---\n",
    "print(\"=== LR on Expanded Train ===\")\n",
    "\n",
    "lr = LogisticRegression(\n",
    "    featuresCol=\"features_linear\",\n",
    "    labelCol=\"label\",\n",
    "    weightCol=\"sample_weight\",\n",
    "    maxIter=100,\n",
    "    probabilityCol=\"probability\",\n",
    "    rawPredictionCol=\"rawPrediction\"\n",
    ")\n",
    "\n",
    "lr_grid = ParamGridBuilder() \\\n",
    "    .addGrid(lr.regParam, [0.01, 0.1, 1.0]) \\\n",
    "    .addGrid(lr.elasticNetParam, [0.0, 0.5, 1.0]) \\\n",
    "    .build()\n",
    "\n",
    "lr_cv = CrossValidator(\n",
    "    estimator=lr,\n",
    "    estimatorParamMaps=lr_grid,\n",
    "    evaluator=MulticlassClassificationEvaluator(\n",
    "        labelCol=\"label\", predictionCol=\"prediction\", metricName=\"f1\"\n",
    "    ),\n",
    "    numFolds=3,\n",
    "    seed=42,\n",
    "    parallelism=4\n",
    ")\n",
    "\n",
    "lr_cv_model = lr_cv.fit(expanded_train)\n",
    "lr_expanded = lr_cv_model.bestModel\n",
    "\n",
    "val_pred_lr_exp = lr_expanded.transform(val)\n",
    "lr_exp_metrics = evaluate_model(val_pred_lr_exp, \"LR_Expanded\")\n",
    "print(f\"Val Macro-F1: {lr_exp_metrics['macro_f1']:.4f}, PR-AUC: {lr_exp_metrics['pr_auc']:.4f}\")"
   ]
